<h1 class="title">Explore Places</h1>
<form action="/places" method="GET" class="mb-5">
  <div class="field">
    <label class="label">Filter by Category</label>

    <div class="control">
      <div class="select">
        <select name="category">
          <option value="">All Categories</option>

          {{#each categories}}
            <option
              value="{{this}}"
              {{#if (eq this ../selectedCategory)}}selected{{/if}}
            >
              {{this}}
            </option>
          {{/each}}
        </select>
      </div>

      <button class="button is-link" type="submit">
        Filter
      </button>

      <a class="button is-light" href="/places">
        Clear
      </a>
    </div>
  </div>
</form>

<div class="columns">
  <div class="column is-two-thirds">
    <h2 class="subtitle">Existing Places</h2>


<div class="columns is-multiline">
  {{#each places}}
    <div class="column is-half">
      <div class="card">

        <div class="card-image">
          {{#if imageUrl}}
            <figure class="image is-16by9">
              <img
                src="{{imageUrl}}"
                alt="{{name}}"
                style="object-fit: cover;"
              />
            </figure>
          {{else}}
            <div class="has-background-light has-text-centered p-6">
              <p class="has-text-grey">No image uploaded</p>
            </div>
          {{/if}}
        </div>

        <div class="card-content">
          <p class="title is-5">{{name}}</p>
          <p class="subtitle is-6">{{category}}</p>

          <p><strong>Location:</strong> {{location}}</p>
          <p>{{description}}</p>
        </div>

        <footer class="card-footer">
          <a
            href="/places/{{id}}"
            class="card-footer-item"
          >
            View
          </a>

          <a
            href="/places/{{id}}/edit"
            class="card-footer-item"
          >
            Edit
          </a>
        </footer>

        <form
          action="/places/{{id}}/delete"
          method="POST"
          class="p-3"
        >
          <button
            type="submit"
            class="button is-danger is-light is-fullwidth"
          >
            Delete
          </button>
        </form>

      </div>
    </div>
  {{/each}}
</div>

  </div>

  <div class="column">
    <h2 class="subtitle">Add a New Place</h2>

    {{#if errors}}
      <div class="notification is-danger">
        <p>Please correct the following errors:</p>

        <ul>
          {{#each errors}}
            <li>{{message}}</li>
          {{/each}}
        </ul>
      </div>
    {{/if}}

    <form action="/places/add" method="POST" novalidate>
      <div class="field">
        <label class="label" for="name">Name</label>
        <div class="control">
          <input
            class="input"
            type="text"
            id="name"
            name="name"
            value="{{values.name}}"
          />
        </div>
      </div>

<div class="field">
  <label class="label" for="category">Category</label>
  <div class="control">
    <div class="select is-fullwidth">
      <select id="category" name="category" required>
        <option value="">Select a category</option>
        {{#each categories}}
          <option value="{{this}}">{{this}}</option>
        {{/each}}
      </select>
    </div>
  </div>
</div>

      <div class="field">
        <label class="label" for="location">Location</label>
        <div class="control">
          <input
            class="input"
            type="text"
            id="location"
            name="location"
            value="{{values.location}}"
          />
        </div>
      </div>
      <div class="field">
  <label class="label">Description</label>
  <textarea
    class="textarea"
    name="description"
    placeholder="Describe this place"
  ></textarea>
</div>

<div class="field">
  <label class="label">Latitude</label>
  <input class="input" type="number" step="any" name="latitude" />
</div>

<div class="field">
  <label class="label">Longitude</label>
  <input class="input" type="number" step="any" name="longitude" />
</div>

      <button class="button is-primary" type="submit">
        Add Place
      </button>
    </form>
  </div>
</div>