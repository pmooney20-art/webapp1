<h1 class="title">Explore Places</h1>
<form action="/places" method="GET" class="mb-5">
  <div class="field">
    <label class="label">Filter by Category</label>

    <div class="control">
      <div class="select">
        <select name="category">
          <option value="">All Categories</option>

          {{#each categories}}
            <option
              value="{{this}}"
              {{#if (eq this ../selectedCategory)}}selected{{/if}}
            >
              {{this}}
            </option>
          {{/each}}
        </select>
      </div>

      <button class="button is-link" type="submit">
        Filter
      </button>

      <a class="button is-light" href="/places">
        Clear
      </a>
    </div>
  </div>
</form>

<div class="columns">
  <div class="column is-two-thirds">
    <h2 class="subtitle">Existing Places</h2>

{{#each places}}
  <div class="box">
    <h3 class="title is-5">{{name}}</h3>

    <p><strong>Category:</strong> {{category}}</p>
    <p><strong>Location:</strong> {{location}}</p>

    <div class="buttons mt-4">
      <a class="button is-info is-small" href="/places/{{id}}/edit">
        Edit
      </a>
      <a class="button is-info is-light" href="/places/{{id}}">
  View Details
</a>

      <form action="/places/{{id}}/delete" method="POST">
        <button class="button is-danger is-small" type="submit">
          Delete
        </button>
      </form>
    </div>
  </div>
{{/each}}
  </div>

  <div class="column">
    <h2 class="subtitle">Add a New Place</h2>

    {{#if errors}}
      <div class="notification is-danger">
        <p>Please correct the following errors:</p>

        <ul>
          {{#each errors}}
            <li>{{message}}</li>
          {{/each}}
        </ul>
      </div>
    {{/if}}

    <form action="/places/add" method="POST" novalidate>
      <div class="field">
        <label class="label" for="name">Name</label>
        <div class="control">
          <input
            class="input"
            type="text"
            id="name"
            name="name"
            value="{{values.name}}"
          />
        </div>
      </div>

<div class="field">
  <label class="label" for="category">Category</label>
  <div class="control">
    <div class="select is-fullwidth">
      <select id="category" name="category" required>
        <option value="">Select a category</option>
        {{#each categories}}
          <option value="{{this}}">{{this}}</option>
        {{/each}}
      </select>
    </div>
  </div>
</div>

      <div class="field">
        <label class="label" for="location">Location</label>
        <div class="control">
          <input
            class="input"
            type="text"
            id="location"
            name="location"
            value="{{values.location}}"
          />
        </div>
      </div>
      <div class="field">
  <label class="label">Description</label>
  <textarea
    class="textarea"
    name="description"
    placeholder="Describe this place"
  ></textarea>
</div>

<div class="field">
  <label class="label">Latitude</label>
  <input class="input" type="number" step="any" name="latitude" />
</div>

<div class="field">
  <label class="label">Longitude</label>
  <input class="input" type="number" step="any" name="longitude" />
</div>

      <button class="button is-primary" type="submit">
        Add Place
      </button>
    </form>
  </div>
</div>